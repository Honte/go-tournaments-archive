{
  "name": "go-tournaments-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:honte": "cross-env CONFIG=honte next dev",
    "dev:europe": "cross-env CONFIG=europe next dev",
    "dev:poland": "cross-env CONFIG=poland next dev",
    "dev:pgc": "cross-env EVENT=pgc next dev",
    "dev:wagc": "cross-env EVENT=wagc next dev",
    "dev:pwgc": "cross-env EVENT=pwgc next dev",
    "dev:pagc": "cross-env EVENT=pagc next dev",
    "dev:pygc": "cross-env EVENT=pygc next dev",
    "dev:kpmc": "cross-env EVENT=kpmc next dev",
    "dev:hrgc": "cross-env EVENT=hrgc next dev",
    "dev:wgl": "cross-env EVENT=wgl next dev",
    "dev:egc": "cross-env EVENT=egc next dev",
    "dev:epc": "cross-env EVENT=epc next dev",
    "dev:esgc": "cross-env EVENT=esgc next dev",
    "dev:ewgc": "cross-env EVENT=ewgc next dev",
    "dev:eygc": "cross-env EVENT=eygc next dev",
    "dev:iegc": "cross-env EVENT=iegc next dev",
    "prebuild": "tsx tools/assets/index.ts",
    "build": "next build",
    "builder": "tsx tools/builder.ts",
    "build:honte": "cross-env CONFIG=honte npm run build",
    "build:pgc": "cross-env EVENT=pgc npm run build",
    "build:wagc": "cross-env EVENT=wagc npm run build",
    "build:pwgc": "cross-env EVENT=pwgc npm run build",
    "build:pagc": "cross-env EVENT=pagc npm run build",
    "build:pygc": "cross-env EVENT=pygc npm run build",
    "build:kpmc": "cross-env EVENT=kpmc npm run build",
    "build:hrgc": "cross-env EVENT=kpmc npm run build",
    "build:wgl": "cross-env EVENT=wgl npm run build",
    "build:egc": "cross-env EVENT=egc npm run build",
    "build:epc": "cross-env EVENT=epc npm run build",
    "build:esgc": "cross-env EVENT=esgc npm run build",
    "build:ewgc": "cross-env EVENT=ewgc npm run build",
    "build:eygc": "cross-env EVENT=eygc npm run build",
    "build:iegc": "cross-env EVENT=iegc npm run build",
    "build:wglx": "cross-env EVENT=wgl BASE_PATH=wgl npm run build",
    "build:epcx": "cross-env EVENT=epc BASE_PATH=epc npm run build",
    "build:esgcx": "cross-env EVENT=esgc BASE_PATH=esgc npm run build",
    "build:ewgcx": "cross-env EVENT=ewgc BASE_PATH=ewgc npm run build",
    "build:iegcx": "cross-env EVENT=iegc BASE_PATH=iegc npm run build",
    "start": "npx serve@latest out",
    "lint": "oxlint .",
    "extract:mp-db": "cross-env EVENT=pgc tsx tools/extract.ts",
    "sgf:match": "tsx tools/sgfMatcher/index.ts",
    "sgf:match:pgc": "cross-env EVENT=pgc tsx tools/sgfMatcher/index.ts",
    "sgf:match:wagc": "cross-env EVENT=wagc tsx tools/sgfMatcher/index.ts",
    "sgf:match:kpmc": "cross-env EVENT=kpmc tsx tools/sgfMatcher/index.ts",
    "sgf:match:pwgc": "cross-env EVENT=pwgc tsx tools/sgfMatcher/index.ts",
    "sgf:match:pagc": "cross-env EVENT=pagc tsx tools/sgfMatcher/index.ts",
    "sgf:match:epc": "cross-env EVENT=epc tsx tools/sgfMatcher/index.ts",
    "sgf:match:iegc": "cross-env EVENT=iegc tsx tools/sgfMatcher/index.ts",
    "test": "node --import tsx --test \"**/*.test.ts\"",
    "fmt": "oxfmt --check .",
    "fmt:write": "oxfmt --write ."
  },
  "dependencies": {
    "@floating-ui/react": "0.27.19",
    "@sabaki/go-board": "1.4.3",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.3",
    "clsx": "2.1.1",
    "fast-glob": "3.3.3",
    "fflate": "0.8.3",
    "go-results-highlighter": "4.0.1",
    "lodash-es": "4.18.1",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.6.0",
    "react-markdown": "10.1.0",
    "sharp": "0.35.2",
    "slugify": "1.6.9",
    "svgo": "4.0.1",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.0",
    "yaml-env-defaults": "2.0.5"
  },
  "devDependencies": {
    "@inquirer/prompts": "8.5.2",
    "@tailwindcss/postcss": "4.3.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "cross-env": "10.1.0",
    "diff": "9.0.0",
    "mysql2": "3.22.5",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "oxlint-tsgolint": "0.23.0",
    "piscina": "5.2.0",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "sharp@0.35.2": true
  }
}
