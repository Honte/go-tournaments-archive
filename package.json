{
  "name": "go-tournaments-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "rimraf .next",
    "dev": "next dev",
    "dev:test": "cross-env CONFIG=test npm run dev",
    "dev:honte": "cross-env CONFIG=honte npm run dev",
    "dev:europe": "cross-env CONFIG=europe npm run dev",
    "dev:poland": "cross-env CONFIG=poland npm run dev",
    "dev:pgc": "cross-env CONFIG=pgc npm run dev",
    "dev:wagc": "cross-env EVENT=wagc npm run dev",
    "dev:kpmc": "cross-env EVENT=kpmc npm run dev",
    "prebuild": "rimraf .next & tsx tools/assets/index.ts",
    "build": "next build",
    "builder": "tsx tools/builder.ts",
    "build:honte": "cross-env CONFIG=honte npm run build",
    "build:europe": "cross-env CONFIG=europe npm run build",
    "build:poland": "cross-env CONFIG=poland npm run build",
    "build:pgc": "cross-env CONFIG=pgc npm run build",
    "deploy:check": "tsx tools/deployment/check.ts",
    "start": "npx serve@latest out",
    "lint": "oxlint .",
    "players:update": "tsx tools/players/build.ts",
    "players:egd": "tsx tools/players/egd.ts",
    "sgf": "tsx tools/sgfMatcher/index.ts",
    "test": "node --import tsx --test \"**/*.test.ts\"",
    "fmt": "oxfmt --check .",
    "fmt:write": "oxfmt --write ."
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@sabaki/go-board": "1.4.3",
    "@tanstack/react-query": "5.108.3",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.28",
    "@wrksz/themes": "2.1.1",
    "clsx": "2.1.1",
    "fast-glob": "3.3.3",
    "fflate": "0.8.3",
    "go-results-highlighter": "4.0.1",
    "lodash-es": "4.18.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "react-select": "5.10.2",
    "rimraf": "6.1.4",
    "sharp": "0.35.5",
    "slugify": "1.6.9",
    "svgo": "4.1.0",
    "tailwind-merge": "3.7.1",
    "yaml": "2.9.1",
    "yaml-env-defaults": "2.0.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@clack/prompts": "1.9.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.7.0",
    "cross-env": "10.1.0",
    "diff": "9.0.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "piscina": "5.3.2",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.35.4": true
  }
}
