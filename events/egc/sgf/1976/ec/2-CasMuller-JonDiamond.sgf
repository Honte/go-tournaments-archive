;B[fg];W[fe];B[lg];W[di];B[ei];W[ej];B[dj];W[eh]C[A serious error. White at 121 would kill the 5 black stones.]
;B[ci];W[fi];B[cj];W[fn]C[Another oversight - if played at 150 instead there is still a chance to win.]
;B[cn];W[bo];B[co];W[cp];B[bn];W[ap]C[Necessary for the life of this group.];B[qr]
C[With this move black establishes a clear lead of 10 to 15 points.];W[hr];B[gn]
