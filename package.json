{
  "name": "go-tournaments-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "rimraf .next",
    "dev": "next dev",
    "dev:honte": "cross-env CONFIG=honte npm run dev",
    "dev:europe": "cross-env CONFIG=europe npm run dev",
    "dev:poland": "cross-env CONFIG=poland npm run dev",
    "dev:pgc": "cross-env CONFIG=pgc npm run dev",
    "dev:wagc": "cross-env EVENT=wagc npm run dev",
    "dev:kpmc": "cross-env EVENT=kpmc npm run dev",
    "prebuild": "rimraf .next & tsx tools/assets/index.ts",
    "build": "next build",
    "builder": "tsx tools/builder.ts",
    "build:honte": "cross-env CONFIG=honte npm run build",
    "build:europe": "cross-env CONFIG=europe npm run build",
    "build:poland": "cross-env CONFIG=poland npm run build",
    "build:pgc": "cross-env CONFIG=pgc npm run build",
    "start": "npx serve@latest out",
    "lint": "oxlint .",
    "extract:mp-db": "tsx tools/extract.ts",
    "players:update": "tsx tools/players/build.ts",
    "players:egd": "tsx tools/players/egd.ts",
    "sgf": "tsx tools/sgfMatcher/index.ts",
    "test": "node --import tsx --test \"**/*.test.ts\"",
    "fmt": "oxfmt --check .",
    "fmt:write": "oxfmt --write ."
  },
  "dependencies": {
    "@floating-ui/react": "0.27.19",
    "@sabaki/go-board": "1.4.3",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.3",
    "clsx": "2.1.1",
    "fast-glob": "3.3.3",
    "fflate": "0.8.3",
    "go-results-highlighter": "4.0.1",
    "lodash-es": "4.18.1",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.6.0",
    "react-markdown": "10.1.0",
    "react-select": "5.10.2",
    "rimraf": "6.1.3",
    "sharp": "0.35.2",
    "slugify": "1.6.9",
    "svgo": "4.0.1",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.0",
    "yaml-env-defaults": "2.0.5"
  },
  "devDependencies": {
    "@inquirer/prompts": "8.5.2",
    "@tailwindcss/postcss": "4.3.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "cross-env": "10.1.0",
    "diff": "9.0.0",
    "mysql2": "3.22.5",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "oxlint-tsgolint": "0.23.0",
    "piscina": "5.2.0",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "sharp@0.35.2": true
  }
}
